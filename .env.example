# Copy this file to .env.local and fill in the keys you have. Both are optional:
# without them the maps use free Esri satellite imagery (sharp down to about zoom 19).

# Google Map Tiles API — usually the sharpest, newest satellite photos in Bangladesh.
# Google Cloud Console → enable "Map Tiles API" → Credentials → API key.
# Restrict the key to your website's address (HTTP referrers) and to the Map Tiles API only.
VITE_GOOGLE_MAPS_KEY=

# Mapbox Satellite — account.mapbox.com → Tokens → default public token (pk....).
VITE_MAPBOX_TOKEN=

# Crop doctor (api/doctor.js) and natural voice (api/tts.js): Google Gemini API key
# (aistudio.google.com/apikey). The voice endpoint uses Gemini TTS for natural Bangladeshi Bangla and British English.
# Spoken replies are sent to Gemini when this key is configured; without it, the browser uses its installed voice.
# Server-side only, never VITE_-prefixed. GEMINI_MODEL is optional (default gemini-3.8-flash).
# For the crop doctor only, an Anthropic key can be used if the Gemini key is absent.
# Locally: put them in .env.local. On Vercel: Project → Settings → Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# Optional voice overrides; use a saved Gemini Voice Design ID for a custom speaker.
# Otherwise the endpoint selects a female-presenting Bangla / British English voice.
GEMINI_TTS_VOICE_BN=
# Set this to the `voice_` ID printed by `npm run design:voice` for the designed Bangladeshi female voice.
GEMINI_TTS_VOICE_EN=
ANTHROPIC_API_KEY=

# NASA Earthdata Login token, only for the data script scripts/fetch/giovanni.mjs (Giovanni monthly rain check).
# Free: urs.earthdata.nasa.gov → Generate Token. Used on your computer only, never in the app or the build.
EARTHDATA_TOKEN=
