{
  "name": "fieldshift360",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "node --test src/engine/engine.test.js src/engine/fieldwatch.test.js src/engine/abroad.test.js src/voice/voice.test.js src/game/sim.test.js src/radar/onset.test.js",
    "fetch:power": "node scripts/fetch-power.mjs",
    "data:aman": "node scripts/data/build_aman_radar.mjs && node scripts/data/build_aman_hazards.mjs",
    "data:fields": "python3 scripts/data/build_field_watch.py",
    "data:prices": "python3 scripts/data/build_market_prices.py",
    "data:seasons": "python3 scripts/data/build_price_seasons.py",
    "data:build": "python3 scripts/data/build_godagari_boundary.py && python3 scripts/data/build_godagari_places.py && python3 scripts/data/build_godagari_landcover.py && python3 scripts/data/build_godagari_boundary.py dhamrai && python3 scripts/data/build_godagari_places.py dhamrai && python3 scripts/data/build_godagari_landcover.py dhamrai && python3 scripts/data/build_bangladesh_crops.py",
    "sync:voice": "node scripts/sync-voice.mjs",
    "radar": "python public/radar/serve.py",
    "data:soil": "python3 scripts/data/build_soil.py",
    "data:srdi": "node scripts/data/build_srdi_frs.mjs",
    "fetch:cmip6": "node scripts/fetch-cmip6.mjs",
    "fetch:stories": "node scripts/fetch-stories.mjs",
    "fetch:neighbours": "python3 scripts/data/build_neighbours.py",
    "photos:abroad": ".cache/venv-sr/bin/python scripts/python/abroad_photos.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
